{
  "name": "mv-clipboard",
  "version": "0.1.0",
  "description": "Histórico da área de transferência (estilo Super+V do Windows 11) para Linux — X11 e Wayland",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i renderer/input.css -o renderer/styles.css --minify",
    "start": "npm run build:css && electron . --ozone-platform=x11",
    "install:all": "bash install.sh",
    "setup:gnome": "bash scripts/setup-gnome.sh",
    "autostart:enable": "bash scripts/autostart.sh enable",
    "doctor": "node src/doctor.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
